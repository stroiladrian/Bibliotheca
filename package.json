{
  "name": "bibliotheca",
  "version": "0.1.0",
  "private": true,
  "description": "Free Romanian audiobooks, Netflix-style: LibriVox recordings plus Romanian classics narrated with AI voices.",
  "scripts": {
    "dev": "npm run catalog && next dev",
    "build": "npm run catalog && next build",
    "preview": "npx --yes serve@14.2.5 out -l 3000",
    "catalog": "node scripts/build-catalog.mjs",
    "sync": "node scripts/sync-librivox.mjs && node scripts/build-catalog.mjs",
    "typecheck": "tsc --noEmit",
    "narrate": "tts/.venv/bin/python tts/narrate.py --queue && node scripts/build-catalog.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
